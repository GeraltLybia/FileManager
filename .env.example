# Директория для загружаемых файлов (по умолчанию: ./src)
# UPLOAD_DIR=./src

# CORS: разрешённые origins через запятую
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Хост и порт сервера (для uvicorn)
# HOST=0.0.0.0
# PORT=8000

# Максимальный размер одного загружаемого файла, в МБ (по умолчанию: 500)
# MAX_UPLOAD_SIZE_MB=500

# Для docker-compose: URL API для фронтенда (как видит браузер)
# VITE_API_BASE=http://localhost:8000
